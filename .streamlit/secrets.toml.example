# Copy this file to .streamlit/secrets.toml (gitignored - never commit real values)
# and fill in your own Turso credentials to run against the hosted database
# instead of the local astra_annotator.db file.
#
# Get these from:
#   turso db show astra-annotator --url
#   turso db tokens create astra-annotator
#
# Leave this file absent (or the two keys unset) to keep using local SQLite.

TURSO_DATABASE_URL = "libsql://astra-annotator-ebeharry.aws-us-west-2.turso.io"
TURSO_AUTH_TOKEN = "paste-your-token-here"
